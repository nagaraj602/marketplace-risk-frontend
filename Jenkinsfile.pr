@Library('sharedlibrary')_

pipeline {
    agent {
        label 'agent'
    }
    environment {
        imageName = "marketplace-risk-frontend-pr"
        dockerTag = "${env.BUILD_NUMBER}"
        gitRepoURL = "https://github.com/nagaraj602/marketplace-risk-frontend.git"
    }
    stages {
        stage('Git Checkout') {
            steps {
                gitCheckout(env.gitRepoURL, env.BRANCH_NAME, "githubCred")
            }
        }

        stage('Build Check') {
            steps {
                sh '''
                    npm ci
                    npm run build
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                sonarAnalysis('marketplace-risk-frontend', 'marketplace-risk-frontend', 'sonar-server', 'sonarToken')
            }
        }

        stage('Docker Build') {
            steps {
                dockerImageBuild(env.imageName, env.dockerTag, 'Dockerfile')
            }
        }

        stage('Trivy Security Scans') {
            steps {
                trivyScan('fs', '.', 'HIGH,CRITICAL', 0)
                trivyScan('config', 'Dockerfile', 'HIGH,CRITICAL', 0)
                trivyScan('image', "${env.imageName}:${env.dockerTag}", 'HIGH,CRITICAL', 0, "frontend-trivy-report-${env.BUILD_NUMBER}.json")
            }
        }
    }
}
